# Токен сообщества ВКонтакте. Не коммитьте реальный ключ.
VK_TOKEN=

# Ключ ProxyAPI для Gemini.
PROXY_API_KEY=

# Короткое имя модели Google без префикса вендора.
GEMINI_MODEL=gemini-2.5-flash

# Базовый адрес ProxyAPI. SDK сам добавляет путь /v1beta/models.
GEMINI_BASE_URL=https://api.proxyapi.ru

# Температура и предел ответа. Необязательные параметры.
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=2048

LOG_LEVEL=INFO
